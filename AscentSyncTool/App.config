<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Legacy VB6 (SAS) SQL Server database -->
    <!--<add name="LegacyDb"
         connectionString="Server=localhost\sqlexpress;Database=StAnns_ASFNdb;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />-->

    <add name="LegacyDb"
    connectionString="Server=STANN-PC;Database=StAnns_ASFNdb;User ID=sa;Password=sa123;TrustServerCertificate=True;"
    providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- New app integration API base URL (must end with a trailing slash) -->
     <add key="ApiBaseUrl" value="https://edu-care.in/api/" /> 
  
    <add key="ApiKey" value=" paste key from edu-care.in=>vbkey" />
    

    <!-- Batch sizes for the bulk endpoints (server caps: receipts 1000, students 500). -->
    <add key="ReceiptBatchSize" value="100" />
    <add key="StudentBatchSize" value="100" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
