<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Legacy VB6 (SAS) SQL Server database -->
    <!--<add name="LegacyDb"
         connectionString="Server=localhost\sqlexpress01;Database=StAnns_ASFNdb;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />-->

    <add name="LegacyDb"
    connectionString="Server=STANN-PC;Database=StAnns_ASFNdb;User ID=sa;Password=sa123;TrustServerCertificate=True;"
    providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- New app integration API base URL (must end with a trailing slash) -->
     <add key="ApiBaseUrl" value="https://edu-care.in/api/" /> 
    <!--<add key="ApiBaseUrl" value="http://192.168.0.102:62845/" />-->

    <!-- Per-school integration API key (school_settings.integration_api_key).
         Generate in SSMS:
           UPDATE school_settings
           SET integration_api_key = LOWER(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''))
           WHERE school_id = <id>;
         Then paste the value here. -->
    <add key="ApiKey" value="key paste here" />
    <!--<add key="ApiKey" value="b638689d8851422e8f4a6ed0344a950d" />--><!--Stanns AsifNagar db-->
    <!--<add key="ApiKey" value="97378867ac044282b36c0da105ef47a9"/>--><!--Demodb-->

    <!-- Batch sizes for the bulk endpoints (server caps: receipts 1000, students 500). -->
    <add key="ReceiptBatchSize" value="200" />
    <add key="StudentBatchSize" value="100" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
