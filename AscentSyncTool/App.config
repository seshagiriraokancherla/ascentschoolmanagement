<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Legacy VB6 (SAS) SQL Server database -->
    <add name="LegacyDb"
         connectionString="Server=DESKTOP-S3KNN28;Database=StAnnsBng;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- New app integration API base URL (must end with a trailing slash) -->
    <!--<add key="ApiBaseUrl" value="https://edu-care.in/api/" />-->
    <add key="ApiBaseUrl" value="http://192.168.0.102:62845/" />

    <!-- Per-school integration API key (school_settings.integration_api_key).
         Generate in SSMS:
           UPDATE school_settings
           SET integration_api_key = LOWER(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''))
           WHERE school_id = <id>;
         Then paste the value here. -->
    <add key="ApiKey" value="e9ab2cf6e72d4b19b3776ede5aa2b8b5" />

    <!-- Batch sizes for the bulk endpoints (server caps: receipts 1000, students 500). -->
    <add key="ReceiptBatchSize" value="200" />
    <add key="StudentBatchSize" value="100" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
