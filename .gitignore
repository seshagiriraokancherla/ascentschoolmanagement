**/bin/
**/obj/
**/packages/
.vs/
.idea/

*.user
*.suo
*.userosscache
*.sln.docstates

# Publish output
**/publish/
**/wwwroot/dist/

# Deploy secrets (FTP credentials) — never commit
deploy/deploy.config.json

# These are hand-edited per run with real DB connection strings / API keys for
# whichever school is currently being migrated/synced — never commit.
AscentMigration/App.config
AscentSyncTool/App.config

# NuGet
*.nupkg
.nuget/

# Test results
TestResults/

# =========================
# React / Node
# =========================

**/node_modules/
**/dist/
**/build/
**/.next/
**/coverage/

# Environment files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production
**/.env.production.local

# School-specific env files (per-flavor prod config; not secrets, but each new school
# was needing a matching line added here by hand and kept getting missed).
# .env.development is a shared dev template with no per-school data — stays tracked.
ascent-school-app/.env.*
!ascent-school-app/.env.development
ascent-parent-app/.env.*
!ascent-parent-app/.env.development

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# General
# =========================

*.log
*.tmp
*.temp

.DS_Store
Thumbs.db

# Windows reserved filename issue
nul
**/nul

# VS Code
.vscode/
# Android / Gradle local build cache — machine-specific, regenerated on every build
**/.gradle/

# Android signing (local only)
keystore.properties
**/keystore.properties

# Firebase secrets (never commit)
# Service-account JSON = a real secret (grants FCM send on the whole project).
**/firebase-service-account.json
API/AscentSchools.API/App_Data/firebase-service-account.json
# google-services.json = client config (not secret, but keep out of the repo).
**/google-services.json
