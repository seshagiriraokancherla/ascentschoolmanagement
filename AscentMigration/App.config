<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <connectionStrings>
    <!-- Update these before running for each school -->
    <add name="Source" connectionString="Server=localhost\SQLEXPRESS01;Database=StAnns_ASFNdb;Trusted_Connection=True;TrustServerCertificate=True;" />
    <add name="Dest"
     connectionString="Server=104.243.32.43;Database=ECdemoSch;User Id=DemoSchoolDb;Password=urMq!3m?dZk84Ice;TrustServerCertificate=True;"
     providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- School branch ID in the new tenant DB (from ascent_master.schools) -->
    <add key="SchoolId"            value="1" />

    <!-- Fallback academic year ID for migrators whose legacy source has no
         academic-year column (fee_categories, fee_types) or whose AcdYear lookup
         misses (terms, fee_structures).
         0 = AUTO: use the latest academic_year_id from the dest academic_years
                   table (resolved at runtime, after AcademicYearsMigrator runs).
         >0      = manual override to a specific academic_year_id.
         Leave at 0 unless you need to pin a specific year. -->
    <add key="DefaultAcademicYearId" value="0" />

    <!-- Comma-separated list of migrators to run, or "all" -->
    <!-- Example: students,fees,terms -->
    <add key="Modules"    value="all" />

    <!-- Set to true to preview without writing anything to dest DB -->
    <add key="DryRun"     value="false" />

    <!-- Rows processed per transaction batch -->
    <add key="BatchSize"  value="100" />

    <!-- Default migration mode for all tables: truncate | skip -->
    <!--   truncate = DELETE existing rows for this school then insert fresh  -->
    <!--   skip     = insert only rows not already present (resume-safe)      -->
    <add key="DefaultMode" value="truncate" />
    <!--<add key="class_groups.mode" value="skip" />
    <add key="academic_years.mode" value="skip" />-->
    <!--<add key="Cleanup" value="true" />-->
    <!--<add key="students.force" value="true" />--> 
    <!--<add key="bus_fee_structures.force" value="true" />-->
    <!-- Per-table mode overrides (uncomment and set as needed) -->
    <!-- <add key="classes.mode"     value="skip" /> -->
    <!-- <add key="students.mode"    value="skip" /> -->

    <!-- Force re-run a completed migrator (deletes its log entry and runs fresh) -->
    <!-- <add key="classes.force"    value="true" /> -->
    <!-- <add key="students.force"   value="true" /> -->
    
    <!-- Default — latest year from SAS_AcdYear (omit the key entirely for same effect) -->
    <!--<add key="fee_receipts.academicYear" value="latest" />-->
    <!-- All years -->
    <!--<add key="fee_receipts.academicYear" value="all" />-->
    <!-- Specific year -->
    <add key="fee_receipts.academicYear" value="2026-2027" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

</configuration>
